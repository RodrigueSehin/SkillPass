# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (Project settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only — never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=

# PostgreSQL (Supabase → Connect). DATABASE_URL = pooled (runtime), DIRECT_URL = direct (migrations)
DATABASE_URL=postgresql://postgres:password@localhost:5432/skillpass
DIRECT_URL=postgresql://postgres:password@localhost:5432/skillpass

# Optional: auth user id to attach the demo seed to
SEED_PROFILE_ID=


# Waiting time (hours) between two attempts at the same assessment. 0 disables it (tests, local demos).
ASSESSMENT_COOLDOWN_HOURS=24

# Demo accounts created by `npm run demo:seed -- --yes` (optional overrides).
# If DEMO_PASSWORD is empty, a random password is generated and printed once.
DEMO_EMAIL=
VERIFIER_EMAIL=
DEMO_PASSWORD=
