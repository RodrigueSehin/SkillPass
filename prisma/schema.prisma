// SkillPass — Phase 1 data model.
// Profile.id mirrors Supabase auth.users.id so RLS policies can use auth.uid().

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  TALENT
  RECRUITER
  MANAGER
  EVALUATOR
  TRAINER
  COMPANY_ADMIN
  ACADEMY_ADMIN
  SKILLPASS_ADMIN
  VERIFIER
}

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum SkillVerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  EXPIRED
}

enum CertificationVerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  EXPIRED
}

enum Availability {
  IMMEDIATE
  ONE_MONTH
  THREE_MONTHS
  NOT_AVAILABLE
}

model Profile {
  id                String       @id @db.Uuid
  email             String       @unique
  username          String       @unique
  fullName          String       @map("full_name")
  headline          String?
  bio               String?
  location          String?
  avatarUrl         String?      @map("avatar_url")
  profession        String?
  yearsOfExperience Int          @default(0) @map("years_of_experience")
  careerGoal        String?      @map("career_goal")
  availability      Availability @default(IMMEDIATE)
  role              UserRole     @default(TALENT)
  isPublic          Boolean      @default(true) @map("is_public")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  talentSkills    TalentSkill[]
  projects        Project[]
  experiences     Experience[]
  certifications  Certification[]
  evidence        SkillEvidence[]
  attempts        AssessmentAttempt[]
  credentials     Credential[]
  recommendations Recommendation[]
  savedOpportunities SavedOpportunity[]
  applications    Application[]
  orgMemberships  OrganizationMember[]
  jobAlerts       JobAlert[]
  contacts        Contact[]
  evaluationAttempts EvaluationAttempt[]

  @@map("profiles")
}

model SkillCategory {
  id     String  @id @default(uuid()) @db.Uuid
  name   String  @unique
  slug   String  @unique
  skills Skill[]

  @@map("skill_categories")
}

model Skill {
  id         String  @id @default(uuid()) @db.Uuid
  name       String  @unique
  slug       String  @unique
  categoryId String? @map("category_id") @db.Uuid

  category      SkillCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  talentSkills  TalentSkill[]
  projectSkills ProjectSkill[]
  certificationSkills CertificationSkill[]
  experienceSkills    ExperienceSkill[]

  @@index([categoryId])
  @@map("skills")
}

model TalentSkill {
  attempts           AssessmentAttempt[]
  credentials        Credential[]
  recommendations    Recommendation[]
  evidence           SkillEvidence[]
  id                 String                  @id @default(uuid()) @db.Uuid
  profileId          String                  @map("profile_id") @db.Uuid
  skillId            String                  @map("skill_id") @db.Uuid
  level              SkillLevel              @default(BEGINNER)
  score              Int                     @default(0)
  yearsOfExperience  Int                     @default(0) @map("years_of_experience")
  verificationStatus SkillVerificationStatus @default(UNVERIFIED) @map("verification_status")
  createdAt          DateTime                @default(now()) @map("created_at")
  updatedAt          DateTime                @updatedAt @map("updated_at")

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  skill   Skill   @relation(fields: [skillId], references: [id], onDelete: Restrict)

  @@unique([profileId, skillId])
  @@index([skillId])
  @@map("talent_skills")
}

model Project {
  recommendations Recommendation[]
  evidence        SkillEvidence[]
  id              String           @id @default(uuid()) @db.Uuid
  profileId       String           @map("profile_id") @db.Uuid
  name            String
  description     String?
  organization    String?
  role            String?
  startDate       DateTime?        @map("start_date")
  endDate         DateTime?        @map("end_date")
  repositoryUrl   String?          @map("repository_url")
  url             String?
  domain          String?
  teamSize        Int?             @map("team_size")
  featured        Boolean          @default(false)
  coverPath       String?          @map("cover_path")
  status          String?
  videoUrl        String?          @map("video_url")
  otherUrl        String?          @map("other_url")
  isPublic        Boolean          @default(true) @map("is_public")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  profile Profile        @relation(fields: [profileId], references: [id], onDelete: Cascade)
  skills  ProjectSkill[]

  @@index([profileId])
  @@map("projects")
}

model ProjectSkill {
  projectId String @map("project_id") @db.Uuid
  skillId   String @map("skill_id") @db.Uuid

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  skill   Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([projectId, skillId])
  @@map("project_skills")
}

model Experience {
  id          String    @id @default(uuid()) @db.Uuid
  profileId   String    @map("profile_id") @db.Uuid
  title       String
  company     String
  location    String?
  description String?
  contractType String?  @map("contract_type")
  workMode    String?   @map("work_mode")
  domain      String?
  startDate   DateTime  @map("start_date")
  endDate     DateTime? @map("end_date")
  createdAt   DateTime  @default(now()) @map("created_at")

  profile Profile           @relation(fields: [profileId], references: [id], onDelete: Cascade)
  skills    ExperienceSkill[]
  documents ExperienceDocument[]

  @@index([profileId])
  @@map("experiences")
}

model ExperienceDocument {
  id           String   @id @default(uuid()) @db.Uuid
  experienceId String   @map("experience_id") @db.Uuid
  path         String
  name         String
  size         Int
  createdAt    DateTime @default(now()) @map("created_at")

  experience Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)

  @@index([experienceId])
  @@map("experience_documents")
}

model ExperienceSkill {
  experienceId String @map("experience_id") @db.Uuid
  skillId      String @map("skill_id") @db.Uuid

  experience Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  skill      Skill      @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([experienceId, skillId])
  @@index([skillId])
  @@map("experience_skills")
}

model Certification {
  id                 String                          @id @default(uuid()) @db.Uuid
  profileId          String                          @map("profile_id") @db.Uuid
  name               String
  issuer             String
  issueDate          DateTime                        @map("issue_date")
  expirationDate     DateTime?                       @map("expiration_date")
  credentialId       String?                         @map("credential_id")
  credentialUrl      String?                         @map("credential_url")
  category           String?
  level              String?
  description        String?
  documentPath       String?                         @map("document_path")
  documentName       String?                         @map("document_name")
  documentSize       Int?                            @map("document_size")
  verificationStatus CertificationVerificationStatus @default(UNVERIFIED) @map("verification_status")
  createdAt          DateTime                        @default(now()) @map("created_at")

  profile Profile              @relation(fields: [profileId], references: [id], onDelete: Cascade)
  skills  CertificationSkill[]

  @@index([profileId])
  @@map("certifications")
}

model CertificationSkill {
  certificationId String @map("certification_id") @db.Uuid
  skillId         String @map("skill_id") @db.Uuid

  certification Certification @relation(fields: [certificationId], references: [id], onDelete: Cascade)
  skill         Skill         @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([certificationId, skillId])
  @@index([skillId])
  @@map("certification_skills")
}

enum EvidenceType {
  PROJECT
  CERTIFICATION
  DOCUMENT
  SCREENSHOT
  LINK
  REPOSITORY
  PORTFOLIO
  ASSESSMENT
  RECOMMENDATION
  EXPERIENCE
}

enum EvidenceVerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
}

model SkillEvidence {
  id            String                     @id @default(uuid()) @db.Uuid
  profileId     String                     @map("profile_id") @db.Uuid
  talentSkillId String                     @map("talent_skill_id") @db.Uuid
  projectId     String?                    @map("project_id") @db.Uuid
  type          EvidenceType
  title         String
  description   String?
  url           String?
  // Storage object key (never a user-supplied name): "<profileId>/<uuid>.<ext>"
  filePath      String?                    @map("file_path")
  fileName      String?                    @map("file_name")
  mimeType      String?                    @map("mime_type")
  sizeBytes     Int?                       @map("size_bytes")
  status        EvidenceVerificationStatus @default(UNVERIFIED)
  createdAt     DateTime                   @default(now()) @map("created_at")

  profile     Profile     @relation(fields: [profileId], references: [id], onDelete: Cascade)
  talentSkill TalentSkill @relation(fields: [talentSkillId], references: [id], onDelete: Cascade)
  project     Project?    @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([profileId])
  @@index([talentSkillId])
  @@map("skill_evidence")
}

enum AttemptStatus {
  IN_PROGRESS
  PASSED
  FAILED
  PENDING_REVIEW
  REJECTED
}

enum CredentialStatus {
  VALID
  REVOKED
}

enum RecommendationStatus {
  REQUESTED
  SUBMITTED
  APPROVED
  DECLINED
}

// Question content lives in code (src/config/assessment-bank.ts, versioned by `bankVersion`):
// correct answers never reach the database read paths exposed to clients.
model AssessmentAttempt {
  id             String        @id @default(uuid()) @db.Uuid
  profileId      String        @map("profile_id") @db.Uuid
  talentSkillId  String        @map("talent_skill_id") @db.Uuid
  assessmentSlug String        @map("assessment_slug")
  bankVersion    Int           @map("bank_version")
  status         AttemptStatus @default(IN_PROGRESS)
  startedAt      DateTime      @default(now()) @map("started_at")
  // Server-enforced time limit.
  deadlineAt     DateTime      @map("deadline_at")
  submittedAt    DateTime?     @map("submitted_at")
  // [{ "questionId": string, "selected": number | null }]
  answers        Json?
  overallScore   Int?          @map("overall_score")
  // { "KNOWLEDGE": number, "PRACTICAL": number, "ARCHITECTURE": number }
  domainScores   Json?         @map("domain_scores")
  level          SkillLevel?
  reviewedById   String?       @map("reviewed_by_id") @db.Uuid
  reviewedAt     DateTime?     @map("reviewed_at")
  reviewNote     String?       @map("review_note")

  profile     Profile     @relation(fields: [profileId], references: [id], onDelete: Cascade)
  talentSkill TalentSkill @relation(fields: [talentSkillId], references: [id], onDelete: Cascade)
  credential  Credential?

  @@index([profileId, assessmentSlug])
  @@index([status])
  @@map("assessment_attempts")
}

model Credential {
  id            String           @id @default(uuid()) @db.Uuid
  // Public identifier, format SP-XXXXXX.
  credentialId  String           @unique @map("credential_id")
  profileId     String           @map("profile_id") @db.Uuid
  talentSkillId String?          @map("talent_skill_id") @db.Uuid
  skillName     String           @map("skill_name")
  level         SkillLevel
  issuer        String           @default("SkillPass")
  issuedAt      DateTime         @default(now()) @map("issued_at")
  expiresAt     DateTime?        @map("expires_at")
  status        CredentialStatus @default(VALID)
  revokedAt     DateTime?        @map("revoked_at")
  attemptId     String?          @unique @map("attempt_id") @db.Uuid

  profile     Profile            @relation(fields: [profileId], references: [id], onDelete: Cascade)
  talentSkill TalentSkill?       @relation(fields: [talentSkillId], references: [id], onDelete: SetNull)
  attempt     AssessmentAttempt? @relation(fields: [attemptId], references: [id], onDelete: SetNull)

  @@index([profileId])
  @@map("credentials")
}

model Recommendation {
  id            String               @id @default(uuid()) @db.Uuid
  profileId     String               @map("profile_id") @db.Uuid
  talentSkillId String?              @map("talent_skill_id") @db.Uuid
  projectId     String?              @map("project_id") @db.Uuid
  // Unguessable, single-use link sent to the recommender (no account needed).
  token         String               @unique
  authorName    String               @map("author_name")
  authorEmail   String?              @map("author_email")
  authorTitle   String?              @map("author_title")
  // How the recommender knows the holder (MANAGER, COLLEAGUE, CLIENT…), a 1-5 rating and free keywords.
  relation      String?
  rating        Int?
  keywords      String[]             @default([])
  // The holder's own words when asking: shown to the recommender on their link.
  requestSubject String?             @map("request_subject")
  requestMessage String?             @map("request_message")
  requestAspects String[]            @default([]) @map("request_aspects")
  content       String?
  status        RecommendationStatus @default(REQUESTED)
  createdAt     DateTime             @default(now()) @map("created_at")
  submittedAt   DateTime?            @map("submitted_at")
  expiresAt     DateTime             @map("expires_at")

  profile     Profile      @relation(fields: [profileId], references: [id], onDelete: Cascade)
  talentSkill TalentSkill? @relation(fields: [talentSkillId], references: [id], onDelete: SetNull)
  project     Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([profileId])
  @@map("recommendations")
}

model Opportunity {
  id           String   @id @default(uuid()) @db.Uuid
  title        String
  company      String
  companyLabel String?  @map("company_label")
  kind         String
  region       String
  location     String
  workMode     String?  @map("work_mode")
  commitment   String?
  domain       String
  level        String
  skills       String[] @default([])
  description  String
  applyUrl     String?  @map("apply_url")
  publishedAt  DateTime @default(now()) @map("published_at")
  createdAt    DateTime @default(now()) @map("created_at")
  deadline     DateTime?
  views        Int      @default(0)
  applicants   Int      @default(0)
  workModeDetail String? @map("work_mode_detail")
  experienceRange String? @map("experience_range")
  salary       String?
  missions     String[] @default([])
  requirements String[] @default([])
  perks        String[] @default([])
  process      String[] @default([])
  optionalSkills String[] @default([]) @map("optional_skills")
  companyLegalName String? @map("company_legal_name")
  companySector String? @map("company_sector")
  companySize  String?  @map("company_size")
  companyAbout String?  @map("company_about")
  companyTagline String? @map("company_tagline")
  companyVerified Boolean @default(false) @map("company_verified")
  companyWebsite String? @map("company_website")

  // Set when the offer was published by an organization: the link back to its job offer.
  sourceOfferId String? @unique @map("source_offer_id") @db.Uuid
  active        Boolean @default(true)

  saved SavedOpportunity[]
  applications Application[]

  @@index([publishedAt])
  @@map("opportunities")
}

model SavedOpportunity {
  profileId     String   @map("profile_id") @db.Uuid
  opportunityId String   @map("opportunity_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")

  profile     Profile     @relation(fields: [profileId], references: [id], onDelete: Cascade)
  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@id([profileId, opportunityId])
  @@index([opportunityId])
  @@map("saved_opportunities")
}

model JobAlert {
  id        String   @id @default(uuid()) @db.Uuid
  profileId String   @map("profile_id") @db.Uuid
  name      String
  query     String?
  kind      String?
  region    String?
  domain    String?
  level     String?
  createdAt DateTime @default(now()) @map("created_at")

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@map("job_alerts")
}

model Contact {
  id        String   @id @default(uuid()) @db.Uuid
  profileId String   @map("profile_id") @db.Uuid
  name      String
  email     String?
  title     String?
  company   String?
  createdAt DateTime @default(now()) @map("created_at")

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@map("contacts")
}

model Application {
  profileId     String   @map("profile_id") @db.Uuid
  opportunityId String   @map("opportunity_id") @db.Uuid
  message       String?
  createdAt     DateTime @default(now()) @map("created_at")

  profile     Profile     @relation(fields: [profileId], references: [id], onDelete: Cascade)
  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@id([profileId, opportunityId])
  @@index([opportunityId])
  @@map("applications")
}

// ---------- SkillPass Business: organizations ----------

model Organization {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  slug        String   @unique
  description String?
  industry    String?
  size        String?
  website     String?
  address     String?
  phone       String?
  email       String?
  timezone    String   @default("Africa/Abidjan")
  language    String   @default("fr")
  verified    Boolean  @default(false)
  plan        String   @default("BUSINESS")
  logoPath    String?  @map("logo_path")
  createdAt   DateTime @default(now()) @map("created_at")

  members     OrganizationMember[]
  jobOffers   JobOffer[]
  evaluations Evaluation[]
  skills      OrganizationSkill[]
  sites       Site[]
  departments Department[]

  @@map("organizations")
}

model OrganizationMember {
  id                String    @id @default(uuid()) @db.Uuid
  organizationId    String    @map("organization_id") @db.Uuid
  profileId         String?   @map("profile_id") @db.Uuid
  firstName         String    @map("first_name")
  lastName          String    @map("last_name")
  email             String
  phone             String?
  jobTitle          String?   @map("job_title")
  role              String    @default("VIEWER")
  permissions       String[]  @default([])
  status            String    @default("INVITED")
  siteId            String?   @map("site_id") @db.Uuid
  managerId         String?   @map("manager_id") @db.Uuid
  invitationMessage String?   @map("invitation_message")
  inviteToken       String?   @unique @map("invite_token")
  inviteExpiresAt   DateTime? @map("invite_expires_at")
  invitedAt         DateTime? @map("invited_at")
  lastActiveAt      DateTime? @map("last_active_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  profile      Profile?           @relation(fields: [profileId], references: [id], onDelete: SetNull)
  departments  DepartmentMember[]
  deputyOf     DepartmentDeputy[]

  @@unique([organizationId, email])
  @@unique([organizationId, profileId])
  @@index([profileId])
  @@map("organization_members")
}

model Site {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  address        String?
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("sites")
}

model Department {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  description    String?
  look           String   @default("users")
  parentId       String?  @map("parent_id") @db.Uuid
  mainSiteId     String?  @map("main_site_id") @db.Uuid
  siteIds        String[] @default([]) @map("site_ids")
  objectives     String[] @default([])
  status         String   @default("ACTIVE")
  accessLevel    String   @default("LIMITED") @map("access_level")
  headId         String?  @map("head_id") @db.Uuid
  replacementId  String?  @map("replacement_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members      DepartmentMember[]
  deputies     DepartmentDeputy[]

  @@index([organizationId])
  @@map("departments")
}

model DepartmentMember {
  departmentId String  @map("department_id") @db.Uuid
  memberId     String  @map("member_id") @db.Uuid
  isPrimary    Boolean @default(false) @map("is_primary")
  role         String  @default("Membre")

  department Department         @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  member     OrganizationMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@id([departmentId, memberId])
  @@index([memberId])
  @@map("department_members")
}

model DepartmentDeputy {
  departmentId String @map("department_id") @db.Uuid
  memberId     String @map("member_id") @db.Uuid
  level        String @default("DEPUTY")

  department Department         @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  member     OrganizationMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@id([departmentId, memberId])
  @@index([memberId])
  @@map("department_deputies")
}

model JobOffer {
  id              String    @id @default(uuid()) @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  createdById     String?   @map("created_by_id") @db.Uuid
  title           String
  description     String    @default("")
  contract        String    @default("CDI")
  location        String    @default("")
  workMode        String?   @map("work_mode")
  departmentId    String?   @map("department_id") @db.Uuid
  experience      String    @default("1 à 3 ans")
  positions       Int       @default(1)
  deadline        DateTime? @db.Date
  salaryMin       Int?      @map("salary_min")
  salaryMax       Int?      @map("salary_max")
  currency        String    @default("FCFA")
  skills          String[]  @default([])
  softSkills      String[]  @default([]) @map("soft_skills")
  certifications  String[]  @default([])
  education       String?
  languages       String[]  @default([])
  otherLanguage   String?   @map("other_language")
  permit          String?
  mobility        String    @default("NONE")
  availability    String    @default("ASAP")
  visibility      String    @default("PUBLIC")
  publishOn       DateTime? @map("publish_on") @db.Date
  durationMonths  Int       @default(2) @map("duration_months")
  channels        String[]  @default(["PLATFORM"])
  applicationMode String    @default("SIMPLE") @map("application_mode")
  status          String    @default("DRAFT")
  opportunityId   String?   @map("opportunity_id") @db.Uuid
  publishedAt     DateTime? @map("published_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("job_offers")
}

// Tests created by an organization. Questions and settings are validated by Zod (src/schemas/evaluation.ts)
// and stored as JSON: they are always read and written together with the test.
model Evaluation {
  id              String    @id @default(uuid()) @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  createdById     String?   @map("created_by_id") @db.Uuid
  title           String
  description     String    @default("")
  skill           String    @default("")
  type            String    @default("TECHNICAL")
  difficulty      String    @default("INTERMEDIATE")
  durationMinutes Int       @default(45) @map("duration_minutes")
  language        String    @default("Français")
  questions       Json      @default("[]")
  settings        Json      @default("{}")
  status          String    @default("DRAFT")
  publishAt       DateTime? @map("publish_at")
  shareToken      String    @unique @default(uuid()) @map("share_token")
  createdAt       DateTime  @default(now()) @map("created_at")

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  attempts     EvaluationAttempt[]

  @@index([organizationId])
  @@map("evaluations")
}

model EvaluationAttempt {
  id           String    @id @default(uuid()) @db.Uuid
  evaluationId String    @map("evaluation_id") @db.Uuid
  profileId    String    @map("profile_id") @db.Uuid
  answers      Json      @default("{}")
  score        Int?
  passed       Boolean?
  // IN_PROGRESS, SUBMITTED (waiting for a person to read open answers) or GRADED
  status       String    @default("IN_PROGRESS")
  startedAt    DateTime  @default(now()) @map("started_at")
  submittedAt  DateTime? @map("submitted_at")

  evaluation Evaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  profile    Profile    @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([evaluationId])
  @@index([profileId])
  @@map("evaluation_attempts")
}

// Skills an organization adds to its own referential, to use in its job offers and evaluations.
// "nameKey" is the lower-cased name: it makes the name unique per organization regardless of case.
model OrganizationSkill {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  nameKey        String   @map("name_key")
  category       String
  kind           String   @default("TECHNICAL")
  description    String   @default("")
  keywords       String[] @default([])
  synonyms       String[] @default([])
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, nameKey])
  @@map("organization_skills")
}
